# Copie para .env e ajuste as portas se 3000/3001 estiverem em uso.
# Backend (NestJS) — porta local e porta publicada no Docker.
BACKEND_PORT=3001
# Frontend (Vite em dev, nginx no Docker) — porta local e porta publicada no Docker.
FRONTEND_PORT=3000
# Opcional: chave global do Resend (envio de e-mails, ex.: recuperar senha).
# Vale para todos; cada usuário pode salvar a própria em Configurações → E-mail.
# RESEND_API_KEY=re_sua_chave_aqui
# Opcional: remetente dos e-mails (exige domínio verificado no Resend).
# Sem isso, usa onboarding@resend.dev — que só entrega para o e-mail da conta Resend.
# EMAIL_REMETENTE=FinFin <naoresponda@seudominio.com>
# Opcional: base do link de recuperação (padrão: http://localhost:<FRONTEND_PORT>).
# FRONTEND_URL=https://finfin.seudominio.com
